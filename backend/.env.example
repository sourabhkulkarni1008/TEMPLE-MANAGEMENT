PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/temple_db
USE_LOCAL_STORAGE=true # Set to true to use built-in zero-config persistent storage for instant demo execution

# JWT Secret & Expiry
JWT_SECRET=super_secure_smart_temple_secret_key_2026_aiml
JWT_EXPIRES_IN=7d

# Email Transporter (Nodemailer)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_email_user@domain.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM="Smart Temple Administration" <no-reply@templedemo.com>

# AI Crowd Service URL
AI_SERVICE_URL=http://localhost:8000
AI_DEMO_MODE=true

# Frontend Client URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Temple Configuration
